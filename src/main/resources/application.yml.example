spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/pulse
    username: pulse_user
    password: pulse_password
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
  flyway:
    enabled: true

jira:
  base-url: https://yoursite.atlassian.net
  email: your@email.com
  api-token: your-api-token-here

server:
  port: 8080